#!/usr/bin/env bash
# commit-msg: enforce Conventional Commits.
set -euo pipefail

MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'

if ! grep -Eq "$PATTERN" <<<"$MSG"; then
  echo "✗ commit-msg: message must follow Conventional Commits." >&2
  echo "  e.g. 'feat(scheduler): add claim-based cron worker'" >&2
  exit 1
fi
exit 0
