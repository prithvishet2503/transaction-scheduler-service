# ============================================================
# Transaction Scheduler Service — local environment variables
# Copy to .env and fill in values as needed.
# HACKATHON DEMO: keys are hardcoded here (no KMS). Do not commit .env.
# ============================================================

# --- Service ---
PORT=3000
NODE_ENV=development

# --- Database (local MongoDB; a local mongod must be running) ---
MONGO_URI=mongodb://localhost:27017/transaction_scheduler

# --- BitGo (testnet) ---
# Environment: 'test' (test.bitgo.com) or 'prod'.
BITGO_ENV=test
# Long-lived, spend-scoped access token for headless execution (see docs/EXTERNAL-INTEGRATIONS.md).
BITGO_ACCESS_TOKEN=<set-your-testnet-access-token>
# Wallet passphrase used to decrypt the user key share for signing.
BITGO_WALLET_PASSPHRASE=<set-your-wallet-passphrase>
# Comma-separated coins to register (e.g. tbaseeth,tbtc). tbaseeth requires
# @bitgo/sdk-coin-eth; tbtc requires @bitgo/sdk-coin-btc.
COINS=tbaseeth

# --- Auth (demo: static API key, hardcoded) ---
API_KEY=dev-api-key

# --- Worker / scheduling ---
WORKER_POLL_INTERVAL_MS=30000
WORKER_LEASE_TTL_MS=120000
WORKER_STUCK_CLAIM_MS=900000
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=100
# Send-failure retry backoff (FR-9): 1m / 5m / 25m
RETRY_BACKOFF_MS=60000,300000,1500000

# --- Reminders (FR-14) ---
DEFAULT_REMINDER_OFFSET_MS=86400000
MIN_REMINDER_OFFSET_MS=3600000

# --- Notifications (demo sink) ---
# POST a JSON payload here on reminder/defaulted/failed events (optional).
NOTIFY_WEBHOOK_URL=
# Kafka brokers for the NCC path (optional; empty = webhook/log only).
KAFKA_BROKERS=
KAFKA_TOPIC_PREFIX=tx-scheduler

# --- Webhook (BitGo transfer-confirmed -> execution 'confirmed') ---
WEBHOOK_SECRET=dev-webhook-secret
