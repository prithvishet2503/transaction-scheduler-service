# Transaction Scheduler Service — local environment variables

PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/transaction_scheduler

# BitGo testnet/prod configuration
BITGO_ENV=test
BITGO_ACCESS_TOKEN=<set-your-testnet-access-token>
BITGO_TEST_ACCESS_TOKEN=
BITGO_BASE_URL=https://app.bitgo-staging.com
BITGO_WALLET_PASSPHRASE=
BITGO_MODE=real
DEMO_SPENDABLE=0
DEMO_PENDING_APPROVAL_ID=
COINS=tbaseeth

# Demo auth
API_KEY=dev-api-key

# Worker / scheduling
WORKER_POLL_INTERVAL_MS=30000
WORKER_LEASE_TTL_MS=120000
WORKER_STUCK_CLAIM_MS=900000
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=100
RETRY_BACKOFF_MS=60000,300000,1500000
TX_REQUEST_POLL_ATTEMPTS=5
TX_REQUEST_POLL_INTERVAL_MS=2000
TX_REQUEST_STATUS_REFRESH_MS=0

# Reminders
DEFAULT_REMINDER_OFFSET_MS=86400000
MIN_REMINDER_OFFSET_MS=3600000

# Notifications
NOTIFY_WEBHOOK_URL=
KAFKA_BROKERS=
KAFKA_TOPIC_PREFIX=tx-scheduler

# Webhook
WEBHOOK_SECRET=dev-webhook-secret
